# ==============================================================================
# NetKeep Café POS — Frontend Client Environment Configuration
# ==============================================================================

# 1. Cloud Central API (Publicly reachable production URL, e.g., Render)
# Required on Vercel deployment: Set to https://netkeep.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://netkeep.onrender.com

# Backward-compatible cloud API URL (can specify root or /api/v1)
NEXT_PUBLIC_CLOUD_API_URL=https://netkeep.onrender.com/api/v1

# 2. Local Café Edge Server (LAN IP of Edge PC on VLAN 10, e.g., http://192.168.10.10:8000/api/v1)
# For local development: http://localhost:8000/api/v1
# For cloud-direct deployment on Vercel: leave empty to communicate directly with Cloud API
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:8000/api/v1

# 3. Café Branding & Outpost Identification
NEXT_PUBLIC_CAFE_NAME=NetKeep Café POS
NEXT_PUBLIC_BRANCH_CODE=CAFE-BLR-01
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# SECURITY NOTE:
# Never prefix secret API keys or database credentials with NEXT_PUBLIC_.
# Terminal authorization keys for communicating with the local server are entered
# on the physical cashier station and persisted securely in browser storage.
