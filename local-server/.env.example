# ==============================================================================
# NetKeep Café — Local Edge Server Configuration (.env)
# ==============================================================================

# Server Network Binding (Binds to 0.0.0.0 for trusted LAN access within the café)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Local SQLite Database (Enforces Write-Ahead Logging WAL mode for concurrent writes)
DATABASE_URL=sqlite:///./netkeep_local.db

# Branch Identity
BRANCH_ID=CAFE-BLR-01
BRANCH_NAME=NetKeep Cyber Arena Indiranagar

# Cloud Central API Endpoint (Public URL of deployed Cloud API, e.g. on Render/Railway)
CLOUD_API_URL=https://your-cloud-api.onrender.com/api/v1

# Security: Shared API Key for trusted LAN POS clients (Rotate to a cryptographically random secret)
# Header: X-API-Key: <key> or Authorization: Bearer <key>
LAN_API_KEY=your-secure-random-lan-secret-key-min-32-chars

# CORS: Comma-separated list of allowed origins (e.g. POS terminal URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.10.10:3000
