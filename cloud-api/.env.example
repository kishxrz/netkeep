# ==============================================================================
# NetKeep Café — Cloud Central API Environment Configuration (.env)
# ==============================================================================

# Server Network Binding
# On Render / Railway / Fly.io, PORT is dynamically set by the platform.
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Local Fallback)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL URI:
# Go to Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# If left blank, the server operates in local development mode with SQLite (./netkeep_cloud.db).
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Connection pool settings (Optimized for PgBouncer poolers)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 2. CORS ORIGINS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. Vercel frontend URL, custom domains)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. SUPABASE PROJECT SETTINGS (Server-Side Only)
# ------------------------------------------------------------------------------
# SECURITY INVARIANT:
# The SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security (RLS) and is strictly
# loaded server-side only. NEVER expose this key to browser clients or frontend bundles!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 4. OWNER & EDGE CAFÉ AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Set to 'false' in production so demo mock data is not seeded automatically.
AUTO_SEED_DEMO_DATA=false

# Production Owner & Admin Auth Bearer Tokens (Rotate to secure random strings)
OWNER_AUTH_TOKEN=your-secure-random-owner-token-min-32-chars
MUMBAI_OWNER_AUTH_TOKEN=your-secure-random-mumbai-owner-token
ADMIN_AUTH_TOKEN=your-secure-random-admin-token

# Edge Café API Keys (Shared secret per physical branch server)
CAFE_BLR_API_KEY=your-secure-edge-cafe-blr-key
CAFE_MUM_API_KEY=your-secure-edge-cafe-mum-key
CAFE_DEL_API_KEY=your-secure-edge-cafe-del-key
